# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# ─── Django core ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ─── AI Virtual Assistant (website chatbot) ───────────────────────────────────
# AI_PROVIDER: auto | anthropic | openai. 'auto' uses whichever key is set below
# (Anthropic preferred). Leave keys blank to disable (widget shows a setup notice).
# NOTE: Claude *Pro* (the $20/mo chat plan) is NOT API access — get an API key from
# console.anthropic.com (separate, pay-as-you-go billing).
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override. Default: claude-opus-4-8 (Anthropic) / gpt-4o-mini (OpenAI).
# For a cheaper high-volume website bot: ASSISTANT_MODEL=claude-haiku-4-5
ASSISTANT_MODEL=

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# For real sending, set EMAIL_BACKEND to the SMTP backend below.
# For local testing without SMTP, use the console backend (prints to log):
#   django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=Dr. Nath Coaching <no-reply@dr-nath.com>

# ─── LiveKit (video calls) ────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ─── Misc ─────────────────────────────────────────────────────────────────────
SITE_URL=https://dr-nath.com

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Required. settings.py has no fallback on purpose — a hard-coded default would
# end up in git. Generate the password with:
#   python -c "import secrets,string; a=string.ascii_letters+string.digits; print(''.join(secrets.choice(a) for _ in range(40)))"
DB_NAME=skillforge
DB_USER=skilluser
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
